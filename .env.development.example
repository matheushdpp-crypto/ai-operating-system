# =============================================================================
# AI Operating System (AiOS) - Development Environment Configuration
# =============================================================================

NODE_ENV=development
PLATFORM_NAME="AiOS Enterprise"
API_PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
CONTROL_CENTER_PORT=8080
CONTROL_CENTER_URL=http://localhost:8080
LOG_LEVEL=info

# Database (PostgreSQL with pgvector)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=aios_admin
DATABASE_PASSWORD=aios_secure_password_change_me
DATABASE_NAME=aios_platform
DATABASE_SSL=false

# n8n Automation Engine
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_ENCRYPTION_KEY=n8n_encryption_secret_key_change_me
N8N_API_KEY=

# Storage (Local or MinIO S3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage_data
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_secure_key
STORAGE_BUCKET=aios-documents

# Authentication & Security
JWT_SECRET=aios_jwt_default_secret_key_change_in_prod
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# AI Models & Embeddings
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional External Agent Runtimes
HERMES_API_URL=
HERMES_API_KEY=
OPENCLAW_API_URL=
OPENCLAW_API_KEY=
