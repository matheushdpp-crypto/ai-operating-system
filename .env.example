# ==============================================================================
# AI OPERATING SYSTEM (AiOS) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure the variables for your deployment.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PLATFORM & CORE API
# ------------------------------------------------------------------------------
NODE_ENV=development
PLATFORM_NAME="AiOS Enterprise"
API_PORT=3000
API_HOST=0.0.0.0
CONTROL_CENTER_PORT=8080
API_BASE_URL=http://localhost:3000
CONTROL_CENTER_URL=http://localhost:8080
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=aios_admin
DATABASE_PASSWORD=aios_secure_password_change_me
DATABASE_NAME=aios_platform
DATABASE_SSL=false
# Full connection string (optional override)
DATABASE_URL=postgresql://aios_admin:aios_secure_password_change_me@localhost:5432/aios_platform

# ------------------------------------------------------------------------------
# 3. N8N WORKFLOW AUTOMATION ENGINE
# ------------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=n8n_api_key_placeholder
N8N_ENCRYPTION_KEY=n8n_encryption_secret_key_change_me

# ------------------------------------------------------------------------------
# 4. AI & AGENT RUNTIME PROVIDERS
# ------------------------------------------------------------------------------
# Default AI Provider: openai | anthropic | ollama | openrouter | hermes
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# API Keys (Set the ones you use; leave empty for local runtimes)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Runtime Adapters (Hermes / OpenClaw / Native)
HERMES_API_URL=http://localhost:8000
HERMES_API_KEY=
OPENCLAW_API_URL=http://localhost:8001
OPENCLAW_API_KEY=

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (S3-Compatible / MinIO)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local # local | s3 | minio
STORAGE_LOCAL_PATH=./storage_data
STORAGE_ENDPOINT=localhost:9000
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_secure_key
STORAGE_BUCKET=aios-documents
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY (RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET=aios_jwt_super_secret_signing_key_replace_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
ENCRYPTION_KEY=32_character_key_for_secrets_enc!

# ------------------------------------------------------------------------------
# 7. MONITORING & AUDIT
# ------------------------------------------------------------------------------
ENABLE_AUDIT_LOGS=true
ENABLE_PROMETHEUS_METRICS=true
METRICS_PORT=9090
TELEMETRY_SAMPLE_RATE=1.0
