# =============================================================================
# AI Operating System (AiOS) - Production Environment Configuration
# =============================================================================
# Run "node scripts/generate-secrets.js" to populate cryptographically secure secrets.

NODE_ENV=production
PLATFORM_NAME="AiOS Enterprise"
API_PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=https://api.yourdomain.com
CONTROL_CENTER_PORT=80
CONTROL_CENTER_URL=https://app.yourdomain.com
LOG_LEVEL=warn

# Database (PostgreSQL with pgvector)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=aios_admin
DATABASE_PASSWORD=CHANGE_ME_RUN_GENERATE_SECRETS
DATABASE_NAME=aios_platform
DATABASE_SSL=false

# n8n Automation Engine
N8N_HOST=n8n.yourdomain.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook
N8N_ENCRYPTION_KEY=CHANGE_ME_RUN_GENERATE_SECRETS
N8N_API_KEY=

# Storage (MinIO or AWS S3)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=storage
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=CHANGE_ME_RUN_GENERATE_SECRETS
STORAGE_SECRET_KEY=CHANGE_ME_RUN_GENERATE_SECRETS
STORAGE_BUCKET=aios-documents

# Authentication & Security (Strict Origins Required in Production)
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_SECRET
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# AI Models & Embeddings
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=sk-prod-...
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=

# Optional External Agent Runtimes
HERMES_API_URL=
HERMES_API_KEY=
OPENCLAW_API_URL=
OPENCLAW_API_KEY=
